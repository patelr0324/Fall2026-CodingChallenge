# Client has no required secrets in Vite.
# In dev, vite.config.ts proxies /api → http://localhost:3001
# so you only need the server/.env configured.
#
# Optional: set a custom API base if you stop using the proxy
# (would require wiring VITE_API_URL in the client fetch helper).
# VITE_API_URL=http://localhost:3001
